# name: test/sql/read_gfa_https.test
# description: Test read_gfa from HTTP URL
# group: [sql]

# `make test` skips this file because httpfs is not linked into unittest;
# run_tests.sh runs it in its httpfs pass.

require miint

require httpfs

require-env MIINT_HTTPS_TEST_URL

# GFA via HTTP
query I
SELECT COUNT(*) FROM read_gfa('${MIINT_HTTPS_TEST_URL}/gfa/spec_example.gfa');
----
10
