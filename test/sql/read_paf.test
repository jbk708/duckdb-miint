# The SAM grammar allows an integer a sign and leading zeros, and a float any form IsFloat
# accepts (sam_style_tags.cpp); each must read as its number.
statement ok
COPY (SELECT * FROM (VALUES
    (E'a\t100\t0\t100\t+\tref\t1000\t0\t100\t100\t100\t60\tNM:i:+7\tcm:i:007\tde:f:nan'),
    (E'b\t100\t0\t100\t+\tref\t1000\t0\t100\t100\t100\t60\tNM:i:-0\tde:f:-NaN'),
    (E'c\t100\t0\t100\t+\tref\t1000\t0\t100\t100\t100\t60\tde:f:+inf'),
    (E'd\t100\t0\t100\t+\tref\t1000\t0\t100\t100\t100\t60\tde:f:-Infinity'),
    (E'e\t100\t0\t100\t+\tref\t1000\t0\t100\t100\t100\t60\tde:f:.5'),
    (E'f\t100\t0\t100\t+\tref\t1000\t0\t100\t100\t100\t60\tde:f:1e400')
) t(line)) TO '__TEST_DIR__/number_forms.paf' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

query TIITT
SELECT read_id, tag_nm, tag_cm, isnan(tag_de), CASE WHEN isinf(tag_de) THEN sign(tag_de)::VARCHAR ELSE tag_de::VARCHAR END
FROM read_paf('__TEST_DIR__/number_forms.paf') ORDER BY read_id;
----
a	7	7	true	nan
b	0	NULL	true	-nan
c	NULL	NULL	false	1
d	NULL	NULL	false	-1
e	NULL	NULL	false	0.5
f	NULL	NULL	false	1

