# name: test/sql/read_paf.test
# description: read_paf reads PAF into miint's 1-based half-open intervals and fails loudly on malformed records
# group: [sql]

require miint

# The fixture's reads were cut from k12_100000_120000 at the coordinates in their names
# (data/paf/README.md), so every expected interval below is derived from how a read was
# built, not copied from minimap2's output. PAF writes intervals 0-based half-open on the
# target and the query alike; miint's are 1-based half-open, so [s, e) in a name must come
# back as s + 1, e + 1 on either sequence (docs/reading.md, "Coordinate conventions").

# --- Errors ---

statement error
SELECT * FROM read_paf('data/paf/does_not_exist.paf');
----
File not found: data/paf/does_not_exist.paf

statement error
SELECT * FROM read_paf(42);
----
read_paf: first argument must be VARCHAR or VARCHAR[]

statement error
SELECT * FROM read_paf('-');
----
read_paf: stdin is not supported

statement error
SELECT * FROM read_paf([]::VARCHAR[]);
----
read_paf: at least one file path must be provided

# Malformed records are written here so each defect sits beside its assertion. Every
# message names the function, the file and the line, then the defect.
statement ok
COPY (SELECT * FROM (VALUES
    (E'ok\t100\t0\t100\t+\tref\t1000\t0\t100\t100\t100\t60'),
    (E'short\t100\t0\t100')
) t(line)) TO '__TEST_DIR__/short_record.paf' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement error
SELECT * FROM read_paf('__TEST_DIR__/short_record.paf');
