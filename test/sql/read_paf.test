# Every typed tag at once, each with its own value, so a key or a type letter wrong in the
# table moves a value into the map or fails the line.
statement ok
COPY (SELECT * FROM (VALUES
    (E'ok\t100\t0\t100\t+\tref\t1000\t0\t100\t100\t100\t60\ttp:A:S\tcm:i:1\ts1:i:2\ts2:i:3\tNM:i:4\tMD:Z:50A49\tAS:i:5\tms:i:6\tnn:i:7\tts:A:+\tcg:Z:100M\tcs:Z::100\tdv:f:0.25\tde:f:0.5\trl:i:8\tzd:i:3\tzz:i:9')
) t(line)) TO '__TEST_DIR__/every_tag.paf' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

query TIIIITIIITTTRRIIT
SELECT tag_tp, tag_cm, tag_s1, tag_s2, tag_nm, tag_md, tag_as, tag_ms, tag_nn, tag_ts, tag_cg, tag_cs,
       tag_dv, tag_de, tag_rl, tag_zd, tags
FROM read_paf('__TEST_DIR__/every_tag.paf');
