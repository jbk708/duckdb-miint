# minimap2's tags are typed columns. A value whose type letter is not the one minimap2
# writes, or that does not fit its column, is an error, not a NULL or a value in the map,
# whichever columns the query reads.
statement ok
COPY (SELECT * FROM (VALUES
    (E'ok\t100\t0\t100\t+\tref\t1000\t0\t100\t100\t100\t60\tNM:f:1.5')
) t(line)) TO '__TEST_DIR__/mistyped_tag.paf' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement error
SELECT read_id FROM read_paf('__TEST_DIR__/mistyped_tag.paf');
----
mistyped_tag.paf: line 1: tag 'NM' has type 'f'; read_paf reads it into tag_nm as type 'i'

statement ok
COPY (SELECT * FROM (VALUES
    (E'ok\t100\t0\t100\t+\tref\t1000\t0\t100\t100\t100\t60\tNM:i:99999999999999999999')
) t(line)) TO '__TEST_DIR__/tag_overflow.paf' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement error
SELECT read_id FROM read_paf('__TEST_DIR__/tag_overflow.paf');
----
tag_overflow.paf: line 1: tag 'NM' value '99999999999999999999' does not fit tag_nm, a 64-bit integer

# A writer other than minimap2 may write one of those tags untyped. Its value is read as the
# column's type, and must be valid for it.
statement ok
COPY (SELECT * FROM (VALUES
    (E'ok\t100\t0\t100\t+\tref\t1000\t0\t100\t100\t100\t60\tNM:five')
) t(line)) TO '__TEST_DIR__/untyped_bad.paf' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

