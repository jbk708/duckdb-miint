# name: test/sql/read_paf_https.test
# description: Test read_paf from HTTP URL
# group: [sql]

# `make test` skips this file because httpfs is not linked into unittest;
# run_tests.sh runs it in its httpfs pass.

require miint

require httpfs

require-env MIINT_HTTPS_TEST_URL

# PAF via HTTP
query I
SELECT COUNT(*) FROM read_paf('${MIINT_HTTPS_TEST_URL}/paf/k12_minimap2.paf');
----
7

# Gzipped PAF via HTTP
query I
SELECT COUNT(*) FROM read_paf('${MIINT_HTTPS_TEST_URL}/paf/k12_minimap2.paf.gz');
----
7
