# name: test/sql/read_gfa_links.test
# description: read_gfa_links returns a GFA file's L records as typed columns; a bad orientation fails the scan
# group: [sql]

require miint

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM read_gfa_links('data/gfa/spec_example.gfa'));
----
from_segment	VARCHAR
from_orientation	VARCHAR
to_segment	VARCHAR
to_orientation	VARCHAR
overlap	VARCHAR
tag_mq	BIGINT
tag_nm	BIGINT
tag_rc	BIGINT
tag_fc	BIGINT
tag_kc	BIGINT
tag_id	VARCHAR
tags	MAP(VARCHAR, VARCHAR)

# The GFA specification's link tags (MQ, NM, RC, FC, KC, ID) are typed columns, NULL when the
# record does not carry them. Every other tag stays in the map.
query TTTTTTT
SELECT from_segment, from_orientation, to_segment, to_orientation, overlap, tag_id, array_to_string(map_keys(tags), '|')
FROM read_gfa_links('data/gfa/spec_example.gfa') ORDER BY from_segment;
----
s1	+	s2	-	4M	link1	(empty)
s2	-	s3	+	NULL	NULL	(empty)

statement ok
COPY (SELECT * FROM (VALUES (E'L\ts1\t+\ts2\t-\t0M\tMQ:i:60\tNM:i:2\tRC:i:5\tFC:i:4\tKC:i:9\tID:Z:e1\tzz:Z:x')) t(line))
TO '{TEST_DIR}/link_tags.gfa' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

query IIIIITT
SELECT tag_mq, tag_nm, tag_rc, tag_fc, tag_kc, tag_id, tags FROM read_gfa_links('{TEST_DIR}/link_tags.gfa');
----
60	2	5	4	9	e1	{zz=x}

statement ok
COPY (SELECT * FROM (VALUES (E'L\ts1\t+\ts2\t-\t0M\tMQ:Z:high')) t(line))
TO '{TEST_DIR}/bad_link_tag.gfa' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement error
SELECT tag_mq FROM read_gfa_links('{TEST_DIR}/bad_link_tag.gfa');
----
read_gfa_links: link s1+ -> s2-: tag MQ is not a 64-bit integer: 'high'

# myloasm records circular contigs as self-links and names the junction reads in r1/r2.
query TTTTTT
SELECT from_segment, from_orientation, to_segment, to_orientation, overlap, tags['r1']
FROM read_gfa_links('data/myloasm/ecoli_sim/final_contig_graph.gfa.gz') ORDER BY from_segment;
----
u840ctg	-	u840ctg	-	0M	s00840_circ_2004395_12875_f+split0
u982ctg	-	u982ctg	-	0M	s00962_circb_2004990_13717_f+split0

# An orientation other than + or - is not a link GFA can express. read_gfa refuses the record
# and names the file and line, so the error fires whichever columns are selected and through
# either view. The S records before it, whose second field is a sequence, pass.
statement ok
COPY (SELECT * FROM (VALUES (E'S\ts1\tACGT'), (E'S\ts2\tACGT'), (E'L\ts1\t+\ts2\tx\t0M')) t(line))
TO '{TEST_DIR}/bad_orientation.gfa' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement error
SELECT from_segment FROM read_gfa_links('{TEST_DIR}/bad_orientation.gfa');
----
bad_orientation.gfa: line 3: an L record's orientations must be + or -, found '+' and 'x'

statement error
SELECT count(*) FROM read_gfa_segments('{TEST_DIR}/bad_orientation.gfa');
----
bad_orientation.gfa: line 3: an L record's orientations must be + or -, found '+' and 'x'
