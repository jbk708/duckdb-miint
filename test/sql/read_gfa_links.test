# name: test/sql/read_gfa_links.test
# description: read_gfa_links returns a GFA file's L records as typed columns and validates orientations
# group: [sql]

require miint

query TTTTTT
SELECT from_segment, from_orientation, to_segment, to_orientation, overlap, array_to_string(map_keys(tags), '|')
FROM read_gfa_links('data/gfa/spec_example.gfa') ORDER BY from_segment;
----
s1	+	s2	-	4M	ID
s2	-	s3	+	NULL	(empty)

# myloasm records circular contigs as self-links and names the junction reads in r1/r2.
query TTTTTT
SELECT from_segment, from_orientation, to_segment, to_orientation, overlap, tags['r1']
FROM read_gfa_links('data/myloasm/ecoli_sim/final_contig_graph.gfa') ORDER BY from_segment;
----
u840ctg	-	u840ctg	-	0M	s00840_circ_2004395_12875_f+split0
u982ctg	-	u982ctg	-	0M	s00962_circb_2004990_13717_f+split0

# An orientation other than + or - is not a link GFA can express. The check must fire even
# when the orientation columns are not selected, and must not fire on other record types,
# whose second field is something else entirely.
statement ok
COPY (SELECT * FROM (VALUES (E'S\ts1\tACGT'), (E'S\ts2\tACGT'), (E'L\ts1\t+\ts2\tx\t0M')) t(line))
TO '__TEST_DIR__/bad_orientation.gfa' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement error
SELECT from_segment FROM read_gfa_links('__TEST_DIR__/bad_orientation.gfa');
----
read_gfa_links: line 3: orientation must be + or -, found '+' and 'x'

query I
SELECT count(*) FROM read_gfa_segments('__TEST_DIR__/bad_orientation.gfa');
----
2
