# name: test/sql/file_uri_paths.test
# description: A file: URI names the local file it points to in every reader and writer, as it does in DuckDB's own
# group: [sql]

require miint

# file:///p, file://localhost/p and file:/p all name /p, as in read_csv. A literal path is read the
# way a glob already was: DuckDB's glob hands back plain paths.
query I
SELECT count(*) FROM read_fastx('file://{WORKING_DIRECTORY}/data/fastq/small_a.fq');
----
2

query I
SELECT count(*) FROM read_fastx('file://localhost{WORKING_DIRECTORY}/data/fastq/small_a.fq');
----
2

query I
SELECT count(*) FROM read_fastx('file:{WORKING_DIRECTORY}/data/fastq/small_a.fq');
----
2

query I
SELECT count(*) FROM read_fastx('file://{WORKING_DIRECTORY}/data/fastq/small_a_r1.fq',
                                sequence2 := 'file://{WORKING_DIRECTORY}/data/fastq/small_a_r2.fq');
----
1

query II
SELECT (SELECT count(*) FROM read_fastx('file://{WORKING_DIRECTORY}/data/fastq/small_a*.fq')),
       (SELECT count(*) FROM read_fastx('data/fastq/small_a*.fq'));
----
4	4

query I
SELECT count(*) FROM read_sequences_sff('file://{WORKING_DIRECTORY}/data/sff/adapter_only_clip.sff');
----
2

# A list of paths is read the same way, path by path, in every reader that takes one.
query I
SELECT count(*) FROM read_fastx(['file://{WORKING_DIRECTORY}/data/fastq/small_a.fq', 'data/fastq/small_a.fq']);
----
4

query I
SELECT count(*) FROM read_fastx(['file://{WORKING_DIRECTORY}/data/fastq/small_a_r1.fq'],
                                sequence2 := ['file://{WORKING_DIRECTORY}/data/fastq/small_a_r2.fq']);
----
1

query I
SELECT count(*) FROM read_sequences_sff(['file://{WORKING_DIRECTORY}/data/sff/adapter_only_clip.sff']);
----
2

query I
SELECT count(*) FROM read_gfa(['file://{WORKING_DIRECTORY}/data/gfa/spec_example.gfa']);
----
10

# The same expansion gives ~ the directory DuckDB's home_directory setting names, as for read_csv.
statement ok
SET home_directory = '{WORKING_DIRECTORY}/data';

query I
SELECT count(*) FROM read_fastx('~/fastq/small_a.fq');
----
2

statement ok
RESET home_directory;

# A file:// target is a local file, so gzip output goes to the local BGZF writer, which takes a level:
# a remote target would refuse COMPRESSION_LEVEL.
statement ok
SET VARIABLE abs_test_dir = CASE WHEN '{TEST_DIR}' LIKE '/%' THEN '{TEST_DIR}' ELSE '{WORKING_DIRECTORY}/{TEST_DIR}' END;

statement ok
COPY (SELECT read_id, sequence1, qual1 FROM read_fastx('data/fastq/small_a.fq'))
TO ('file://' || getvariable('abs_test_dir') || '/uri_level.fq.gz') (FORMAT FASTQ, COMPRESSION_LEVEL 0);

query I
SELECT left(hex(content), 4) FROM read_blob('{TEST_DIR}/uri_level.fq.gz');
----
1F8B

query II
SELECT read_id, sequence1 FROM read_fastx('{TEST_DIR}/uri_level.fq.gz') ORDER BY read_id;
----
read_a1	AAAA
read_a2	TTTT
