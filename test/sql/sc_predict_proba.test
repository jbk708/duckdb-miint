# name: test/sql/sc_predict_proba.test
# description: test predict_proba table function
# group: [sql]

require miint

statement ok
PRAGMA enable_verification;

# The 15 cells of data/biom/test.biom, inlined so this file needs no HDF5.
statement ok
CREATE TABLE test_biom (sample_id VARCHAR, feature_id VARCHAR, value DOUBLE);

statement ok
INSERT INTO test_biom VALUES
  ('Sample1', 'GG_OTU_2', 5.0),
  ('Sample1', 'GG_OTU_4', 2.0),
  ('Sample2', 'GG_OTU_2', 1.0),
  ('Sample2', 'GG_OTU_4', 1.0),
  ('Sample2', 'GG_OTU_5', 1.0),
  ('Sample3', 'GG_OTU_1', 1.0),
  ('Sample3', 'GG_OTU_3', 1.0),
  ('Sample3', 'GG_OTU_4', 1.0),
  ('Sample3', 'GG_OTU_5', 1.0),
  ('Sample4', 'GG_OTU_2', 2.0),
  ('Sample4', 'GG_OTU_3', 4.0),
  ('Sample5', 'GG_OTU_2', 3.0),
  ('Sample6', 'GG_OTU_2', 1.0),
  ('Sample6', 'GG_OTU_3', 2.0),
  ('Sample6', 'GG_OTU_4', 1.0);

statement ok
CREATE TABLE pp_data AS SELECT * FROM test_biom;

# Three classes, so the FixedSizeList has width 3 and a stride bug would be
# visible rather than hidden by a binary split.
statement ok
CREATE TABLE pp_meta AS
  SELECT unnest(['Sample1','Sample2','Sample3','Sample4','Sample5','Sample6']) AS sample_id,
         unnest(['gut','gut','gut','skin','skin','oral']) AS value;

statement ok
CREATE TABLE pp_models AS
  SELECT * FROM fit_classifier('pp_data','pp_meta', n_estimators := 100, random_state := 1, name := 'site');

# One row per (sample, class): 6 samples x 3 classes.
query I
SELECT count(*) FROM predict_proba('pp_data', 'pp_models', name := 'site');
----
18

query I
SELECT list_sort(list(DISTINCT class)) FROM predict_proba('pp_data', 'pp_models', name := 'site');
----
[gut, oral, skin]

# Probabilities over a sample's classes are a distribution.
query I
SELECT bool_and(abs(total - 1.0) < 1e-9) FROM (
  SELECT sum(probability) AS total FROM predict_proba('pp_data','pp_models', name := 'site') GROUP BY sample_id);
----
true

query I
SELECT bool_and(probability BETWEEN 0.0 AND 1.0) FROM predict_proba('pp_data', 'pp_models', name := 'site');
----
true

# The check on the FixedSizeList decoding: sc flattens
# n_samples x n_classes row-major, and reading it with the wrong stride would
# put a sample's probabilities against the wrong classes. The highest-probability
# class must therefore equal what predict returns for the same sample, which
# comes from an entirely separate sc call. Each sample here has one class on
# top, so row_number picks it rather than breaking a tie.
query I
SELECT bool_and(p.prediction = a.class) FROM predict('pp_data','pp_models', name := 'site') p
JOIN (SELECT sample_id, class, row_number() OVER (PARTITION BY sample_id ORDER BY probability DESC) rn
      FROM predict_proba('pp_data','pp_models', name := 'site')) a
  ON a.sample_id = p.sample_id AND a.rn = 1;
----
true

# Same model, same data, same numbers -- decoding must be a pure function.
query I
SELECT (SELECT list(probability ORDER BY sample_id, class) FROM predict_proba('pp_data','pp_models', name := 'site'))
     = (SELECT list(probability ORDER BY sample_id, class) FROM predict_proba('pp_data','pp_models', name := 'site'));
----
true

# A two-class model gives width 2, so the width comes from the model rather than
# being assumed.
statement ok
CREATE TABLE pp_binary_meta AS
  SELECT unnest(['Sample1','Sample2','Sample3','Sample4','Sample5','Sample6']) AS sample_id,
         unnest(['gut','gut','gut','skin','skin','skin']) AS value;

statement ok
CREATE TABLE pp_binary AS
  SELECT * FROM fit_classifier('pp_data','pp_binary_meta', n_estimators := 20, random_state := 1, name := 'bin');

query II
SELECT count(*), count(DISTINCT class) FROM predict_proba('pp_data', 'pp_binary', name := 'bin');
----
12	2

# --- known_feature_fraction, same semantics as predict ---

statement ok
CREATE TABLE pp_mixed AS
  SELECT sample_id, feature_id, value FROM pp_data WHERE sample_id IN ('Sample1','Sample2')
  UNION ALL
  SELECT sample_id, 'ALIEN_' || feature_id, value FROM pp_data WHERE sample_id IN ('Sample1','Sample2');

# known_feature_fraction is per sample and repeats across that sample's class rows.
query I
SELECT list_sort(list(DISTINCT known_feature_fraction)) FROM predict_proba('pp_mixed', 'pp_models', name := 'site');
----
[0.5]

# Dropped cells are reported as predict reports them, including the samples
# left with no known feature, whose probabilities come from an all-zero row.
statement ok
SET enable_logging = true;

statement ok
CREATE TABLE pp_partial AS
  SELECT sample_id, feature_id, value FROM pp_data WHERE sample_id = 'Sample1'
  UNION ALL SELECT 'Stranger', 'NEVER_SEEN', 42.0;

statement ok
CREATE TABLE pp_partial_out AS SELECT * FROM predict_proba('pp_partial', 'pp_models', name := 'site');

query I
SELECT bool_or(message LIKE 'predict_proba: dropped 1 cell(s) from ''pp_partial''%1 sample(s) retained no features at all%')
FROM miint_warnings();
----
true

statement ok
CREATE TABLE pp_alien AS SELECT sample_id, 'ALIEN_' || feature_id AS feature_id, value FROM pp_data;

statement error
SELECT * FROM predict_proba('pp_alien', 'pp_models', name := 'site');
----
do not share a feature vocabulary

# --- errors ---

# A regressor has no classes. Caught at bind, before any scanning.
statement ok
CREATE TABLE pp_reg_meta AS SELECT sample_id, sum(value) AS month FROM pp_data GROUP BY sample_id;

statement ok
CREATE TABLE pp_reg AS
  SELECT * FROM fit_regressor('pp_data','pp_reg_meta', n_estimators := 10, random_state := 1, name := 'reg');

statement error
SELECT * FROM predict_proba('pp_data', 'pp_reg', name := 'reg');
----
is a regressor, which has no classes

# The remedy carries the name over, so it runs on a table of several models.
statement error
SELECT * FROM predict_proba('pp_data', 'pp_reg', name := 'reg');
----
SELECT * FROM predict('pp_data', 'pp_reg', name := 'reg');

statement error
SELECT * FROM predict_proba('pp_models', 'pp_models', name := 'site');
----
does not match the required COO triplet schema

statement error
SELECT * FROM predict_proba('pp_data', 'pp_models', name := 'nope');
----
No model named 'nope'

# sc sums duplicate cells, so a fanned-out row would silently inflate a count
# and move the probabilities. Rejected, as at fit.
statement ok
CREATE TABLE pp_fanned AS SELECT * FROM pp_data UNION ALL (SELECT * FROM pp_data LIMIT 1);

statement error
SELECT * FROM predict_proba('pp_fanned', 'pp_models', name := 'site');
----
predict_proba: 1 duplicate (sample_id, feature_id) cell(s) in 'pp_fanned'

# A NULL parameter is an error, not an omitted one: a NULL name would otherwise
# select the relation's only model.
statement error
SELECT * FROM predict_proba('pp_data', 'pp_binary', name := NULL);
----
predict_proba: named parameter 'name' must not be NULL

statement error
SELECT * FROM predict_proba('pp_data', 'pp_binary', threads := 2);
----
Invalid named parameter "threads" for function predict_proba
