# name: test/sql/read_myloasm_links.test
# description: read_myloasm_links returns myloasm's contig graph edges with their overlap evidence as typed columns
# group: [sql]

require miint

# The fixture's text files are committed gzipped (data/myloasm/README.md). The functions read
# a directory as myloasm writes it, so rebuild one: create its directories, then decompress
# the files myloasm writes as text and copy the ones it writes gzipped.
foreach dir ecoli_sim ecoli_sim/alternate_assemblies ecoli_sim/3-mapping ecoli_sim/0-cleaning_and_unitigs ecoli_sim/0-cleaning_and_unitigs/remap_temp

statement ok
COPY (SELECT 1 AS x) TO '{TEST_DIR}/{dir}' (FORMAT csv, PER_THREAD_OUTPUT true, OVERWRITE_OR_IGNORE true);

endloop

unzip data/myloasm/ecoli_sim/assembly_primary.fa.gz {TEST_DIR}/ecoli_sim/assembly_primary.fa

unzip data/myloasm/ecoli_sim/alternate_assemblies/assembly_alternate.fa.gz {TEST_DIR}/ecoli_sim/alternate_assemblies/assembly_alternate.fa

unzip data/myloasm/ecoli_sim/alternate_assemblies/duplicated_contigs.fa.gz {TEST_DIR}/ecoli_sim/alternate_assemblies/duplicated_contigs.fa

unzip data/myloasm/ecoli_sim/final_contig_graph.gfa.gz {TEST_DIR}/ecoli_sim/final_contig_graph.gfa

unzip data/myloasm/ecoli_sim/myloasm.log.gz {TEST_DIR}/ecoli_sim/myloasm.log

foreach member 3-mapping/map_to_unitigs.paf.gz 0-cleaning_and_unitigs/read_coverages.txt.gz 0-cleaning_and_unitigs/remap_temp/read_coverages.txt.gz

statement ok
COPY (SELECT line FROM read_csv('data/myloasm/ecoli_sim/{member}', columns = {'line': 'VARCHAR'}, delim = E'\x01', quote = '', escape = '', header = false, auto_detect = false))
TO '{TEST_DIR}/ecoli_sim/{member}' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01', COMPRESSION gzip);

endloop

# --- Schema ---

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM read_myloasm_links('{TEST_DIR}/ecoli_sim'));
----
from_contig_id	VARCHAR
from_orientation	VARCHAR
to_contig_id	VARCHAR
to_orientation	VARCHAR
overlap_length	BIGINT
shared_snpmers	BIGINT
differing_snpmers	BIGINT
shared_minimizers	BIGINT
snpmer_identity_percent	DOUBLE
from_read_id	VARCHAR
from_split_suffix	VARCHAR
to_read_id	VARCHAR
to_split_suffix	VARCHAR

# The fixture's two links are the circular contigs' self-loops. ol/ss/sd/sm/fs/r1/r2 are
# myloasm's L tags (documented on the GFA's second line); the CIGAR is a 0M placeholder and
# is dropped.
query TTTTIIIIRTTTT
SELECT * FROM read_myloasm_links('{TEST_DIR}/ecoli_sim') ORDER BY from_contig_id;
----
u840ctg	-	u840ctg	-	11219	11	0	1018	100.0	s00840_circ_2004395_12875_f	+split0	s00834_circ_2000787_14856_f	+split0
u982ctg	-	u982ctg	-	10847	10	0	981	100.0	s00962_circb_2004990_13717_f	+split0	s00956_circb_2000164_15698_f	+split0

# --- Intent: a link joins the contigs' end reads ---

# r1 and r2 are the reads at the two ends that meet. Leaving a contig on its '-' strand
# leaves from its first read; entering one on its '-' strand enters at its last read. So for
# these self-loops, r1 is the contig's first layout read and r2 its last, and both contigs
# exist in read_myloasm_contigs.
query TTTT
SELECT k.from_contig_id,
       f.layout_order = 1,
       t.layout_order = (SELECT max(layout_order) FROM read_myloasm_layout('{TEST_DIR}/ecoli_sim') x WHERE x.contig_id = k.to_contig_id),
       k.from_contig_id IN (SELECT contig_id FROM read_myloasm_contigs('{TEST_DIR}/ecoli_sim'))
         AND k.to_contig_id IN (SELECT contig_id FROM read_myloasm_contigs('{TEST_DIR}/ecoli_sim'))
FROM read_myloasm_links('{TEST_DIR}/ecoli_sim') k
JOIN read_myloasm_layout('{TEST_DIR}/ecoli_sim') f
  ON f.contig_id = k.from_contig_id AND f.read_id = k.from_read_id AND f.split_suffix = k.from_split_suffix
JOIN read_myloasm_layout('{TEST_DIR}/ecoli_sim') t
  ON t.contig_id = k.to_contig_id AND t.read_id = k.to_read_id AND t.split_suffix = k.to_split_suffix
ORDER BY k.from_contig_id;
----
u840ctg	true	true	true
u982ctg	true	true	true

# --- myloasm 0.6.0 ---

# myloasm 0.6.0 assembled the same reads into the same graph, but wrote its L lines with no
# tags (data/myloasm/README.md). Its links are 0.7.0's edges, with the evidence unknown.
statement ok
COPY (SELECT 1 AS x) TO '{TEST_DIR}/ecoli_sim_0.6.0' (FORMAT csv, PER_THREAD_OUTPUT true, OVERWRITE_OR_IGNORE true);

unzip data/myloasm/ecoli_sim_0.6.0/final_contig_graph.gfa.gz {TEST_DIR}/ecoli_sim_0.6.0/final_contig_graph.gfa

query TTTTIIIIRTTTT
SELECT * FROM read_myloasm_links('{TEST_DIR}/ecoli_sim_0.6.0') ORDER BY from_contig_id;
----
u840ctg	-	u840ctg	-	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL
u982ctg	-	u982ctg	-	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL

query I
SELECT count(*) FROM (
  (SELECT from_contig_id, from_orientation, to_contig_id, to_orientation FROM read_myloasm_links('{TEST_DIR}/ecoli_sim')
   EXCEPT ALL
   SELECT from_contig_id, from_orientation, to_contig_id, to_orientation FROM read_myloasm_links('{TEST_DIR}/ecoli_sim_0.6.0'))
  UNION ALL
  (SELECT from_contig_id, from_orientation, to_contig_id, to_orientation FROM read_myloasm_links('{TEST_DIR}/ecoli_sim_0.6.0')
   EXCEPT ALL
   SELECT from_contig_id, from_orientation, to_contig_id, to_orientation FROM read_myloasm_links('{TEST_DIR}/ecoli_sim')));
----
0

# --- Errors ---

statement error
SELECT * FROM read_myloasm_links(NULL);
----
read_myloasm: the myloasm output directory cannot be NULL

statement error
SELECT * FROM read_myloasm_links('data/myloasm/does_not_exist');
----
data/myloasm/does_not_exist/final_contig_graph.gfa

# myloasm omits fs when the contigs share no minimizers, so a link without it is NULL there.
# Every other tag is always written; a link without one is not myloasm's.
statement ok
COPY (SELECT 1 AS x) TO '{TEST_DIR}/links_constructed' (FORMAT csv, PER_THREAD_OUTPUT true, OVERWRITE_OR_IGNORE true);

statement ok
COPY (SELECT * FROM (VALUES
  (E'S\tu1ctg\t*\tLN:i:5000'),
  (E'S\tu2ctg\t*\tLN:i:5000'),
  (E'L\tu1ctg\t+\tu2ctg\t+\t0M\tol:i:900\tsd:i:0\tss:i:0\tsm:i:0\tr1:Z:a+split0\tr2:Z:b')) t(line))
TO '{TEST_DIR}/links_constructed/final_contig_graph.gfa' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

query TIRTTTT
SELECT from_contig_id, shared_minimizers, snpmer_identity_percent, from_read_id, from_split_suffix, to_read_id, to_split_suffix
FROM read_myloasm_links('{TEST_DIR}/links_constructed');
----
u1ctg	0	NULL	a	+split0	b	NULL

statement ok
COPY (SELECT * FROM (VALUES
  (E'S\tu1ctg\t*\tLN:i:5000'),
  (E'S\tu2ctg\t*\tLN:i:5000'),
  (E'L\tu1ctg\t+\tu2ctg\t+\t0M\tsd:i:0\tss:i:0\tsm:i:0\tr1:Z:a\tr2:Z:b')) t(line))
TO '{TEST_DIR}/links_constructed/final_contig_graph.gfa' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement error
SELECT from_contig_id FROM read_myloasm_links('{TEST_DIR}/links_constructed');
----
read_myloasm_links: link u1ctg+ -> u2ctg+ has some of myloasm's tags but not all of ol/ss/sd/sm/r1/r2 with valid values

# --- myloasm 0.6.0: links carry no tags ---

# myloasm 0.6.0 writes L lines with no tags at all; the tags arrived in 0.7.0. The link's
# topology is known, but its overlap and end reads are not: the 0M field is a placeholder in
# both versions, so the overlap length is NULL, not 0.
statement ok
COPY (SELECT * FROM (VALUES
  (E'S\tu1ctg\t*\tLN:i:5000'),
  (E'S\tu2ctg\t*\tLN:i:5000'),
  (E'L\tu1ctg\t+\tu2ctg\t-\t0M')) t(line))
TO '{TEST_DIR}/links_constructed/final_contig_graph.gfa' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

query TTTTIIIIRTTTT
SELECT * FROM read_myloasm_links('{TEST_DIR}/links_constructed');
----
u1ctg	+	u2ctg	-	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL

# A link with any of myloasm's tags is the 0.7.0 form, so it must carry all of them. fs alone
# is not the tagless form.
statement ok
COPY (SELECT * FROM (VALUES
  (E'S\tu1ctg\t*\tLN:i:5000'),
  (E'S\tu2ctg\t*\tLN:i:5000'),
  (E'L\tu1ctg\t+\tu2ctg\t+\t0M\tfs:f:100.0')) t(line))
TO '{TEST_DIR}/links_constructed/final_contig_graph.gfa' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement error
SELECT from_contig_id FROM read_myloasm_links('{TEST_DIR}/links_constructed');
----
read_myloasm_links: link u1ctg+ -> u2ctg+ has some of myloasm's tags but not all of ol/ss/sd/sm/r1/r2 with valid values

# Without tags, the 0M placeholder is what makes a link myloasm's; a tagless link with a real
# overlap is another assembler's, and its overlap would be lost.
statement ok
COPY (SELECT * FROM (VALUES
  (E'S\tu1ctg\t*\tLN:i:5000'),
  (E'S\tu2ctg\t*\tLN:i:5000'),
  (E'L\tu1ctg\t+\tu2ctg\t-\t150M')) t(line))
TO '{TEST_DIR}/links_constructed/final_contig_graph.gfa' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement error
SELECT from_contig_id FROM read_myloasm_links('{TEST_DIR}/links_constructed');
----
read_myloasm_links: link u1ctg+ -> u2ctg- has no tags and overlap 150M, not myloasm's 0M placeholder

# One myloasm version wrote the whole file, so it has tagged links or tagless ones, not both.
# A tagless link among tagged ones would read as a 0.6.0 link with unknown evidence.
statement ok
COPY (SELECT * FROM (VALUES
  (E'S\tu1ctg\t*\tLN:i:5000'),
  (E'S\tu2ctg\t*\tLN:i:5000'),
  (E'L\tu1ctg\t+\tu2ctg\t+\t0M\tol:i:900\tsd:i:0\tss:i:0\tsm:i:0\tr1:Z:a\tr2:Z:b'),
  (E'L\tu2ctg\t+\tu1ctg\t+\t0M')) t(line))
TO '{TEST_DIR}/links_constructed/final_contig_graph.gfa' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement error
SELECT from_contig_id FROM read_myloasm_links('{TEST_DIR}/links_constructed');
----
read_myloasm_links: final_contig_graph.gfa has links with myloasm's tags (0.7.0) and links without them (0.6.0)
