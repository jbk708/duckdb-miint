# name: test/sql/rype_filter_multipart.test
# description: rype_filter refuses a multi-part minimap2 index before it returns a row
# group: [sql]

require miint

# The fixture is generated by run_tests.sh, as for align_minimap2_multipart.test,
# whose header says why the paths below are hardcoded.
require-env MIINT_MINIMAP2_MULTIPART_FIXTURE

statement ok
CREATE TABLE short_reads AS
SELECT i AS ord, 'TTGACCATGGCATTCAGGTACCGATTGCAAGTCCTAGGCTAACGGTTCAAGCTTAGCCGATCGGTACCATG' AS sequence1
FROM range(10) t(i);

statement error
SELECT * FROM rype_filter('short_reads', 'data/rype/test.ryxdi', 'data/shards/multipart_fixture.mmi');
----
'data/shards/multipart_fixture.mmi' is a multi-part minimap2 index

# Each of its parts is single-part, and loads.
statement ok
SELECT * FROM rype_filter('short_reads', 'data/rype/test.ryxdi', 'data/shards/multipart_fixture_part1.mmi');

# Long reads never open the index, so its parts do not matter.
statement ok
CREATE TABLE long_reads AS SELECT i AS ord, repeat('TTGACCATGGCA', 40) AS sequence1 FROM range(10) t(i);

query I
SELECT count(*) FROM rype_filter('long_reads', 'data/rype/test.ryxdi', 'data/shards/multipart_fixture.mmi');
----
10
