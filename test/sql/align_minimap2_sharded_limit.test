# name: test/sql/align_minimap2_sharded_limit.test
# description: A LIMIT met before align_minimap2_sharded runs out ends the query
# group: [sql]

require miint

# Two workers per shard. shard_a holds a few reads, so one of its workers runs out of them
# while shard_b, whose two workers keep it full, still has thousands, and waits for a place on
# shard_b. The LIMIT is met long before shard_b runs out, and DuckDB then ends the workers
# holding shard_b without another Execute call; the query has to end rather than leave the
# waiting worker waiting for them.

statement ok
SET threads = 4;

statement ok
CREATE TABLE q AS
SELECT 'a' || i AS read_id, 'ACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGT' AS sequence1,
       'shard_a' AS shard_name
FROM range(10) t(i)
UNION ALL
SELECT 'b' || i, 'TGCATGCATGCATGCATGCATGCATGCATGCATGCATGCATGCATGCATGCA', 'shard_b'
FROM range(40960) t(i);

statement ok
CREATE TABLE reads AS SELECT read_id, sequence1 FROM q;

statement ok
CREATE TABLE routing AS SELECT read_id, shard_name FROM q;

query I
SELECT count(*) FROM (
    SELECT * FROM align_minimap2_sharded('reads',
        shard_directory := 'data/shards/',
        read_to_shard := 'routing',
        max_threads_per_shard := 2)
    LIMIT 1);
----
1

# In a recursive CTE the scan runs again on each iteration, and DuckDB keeps its executors
# between runs: it replaces the scan's global state before the local states of the run before,
# which the LIMIT left holding shards. Their release must not reach the global state that is
# gone.
query I
WITH RECURSIVE r(n) AS (
    SELECT 1
    UNION ALL
    SELECT n + 1 FROM r, (
        SELECT read_id FROM align_minimap2_sharded('reads',
            shard_directory := 'data/shards/',
            read_to_shard := 'routing',
            max_threads_per_shard := 2)
        LIMIT 1) s
    WHERE n < 3)
SELECT count(*) FROM r;
----
3
