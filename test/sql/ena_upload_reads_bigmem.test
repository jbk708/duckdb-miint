# name: test/sql/ena_upload_reads_bigmem.test
# description: ena_upload_reads uploads a single sample far larger than memory_limit losslessly
# group: [sql]

#
# Opt-in / expensive (encodes millions of reads), so it is gated behind
# MIINT_ENA_BIG_STREAM_TEST (exported by run_tests.sh when set). It checks that
# a single sample whose materialised size far exceeds the configured
# memory_limit uploads losslessly.
#
# The streaming evidence is RSS, not this test. The SendQuery path Fetches one
# DataChunk at a time: peak RSS of the DuckDB shell running this file's view
# through ena_upload_reads (/usr/bin/time) was 116 MB for 200k reads, 108 MB for
# 2M and 95 MB for 3M — flat in N. This test does not assert RSS, and it cannot
# catch a materialized read through Query: a materialized Query result is
# allocated outside DuckDB's tracked memory, so it completes under memory_limit
# whenever the machine has the RAM.

require miint

require-env MIINT_ENA_BIG_STREAM_TEST

# Bound DuckDB's tracked memory well below the dataset's materialised footprint
# (~1.4 GB for 3M x 200 bp reads + equal-length quality lists). A streaming scan
# stays comfortably under this; an ORDER BY over the payload fails with Out of
# Memory.
statement ok
SET memory_limit = '512MB';

# Lazy single-sample view: nothing is built until scanned, and each scan streams.
statement ok
CREATE VIEW big_reads AS
  SELECT 'bigsample' AS sample_ref,
         'r' || i AS read_id,
         repeat('ACGT', 50) AS sequence1,                       -- 200 bp
         list_resize([40]::UTINYINT[], 200, 40::UTINYINT) AS qual1,
         CAST(NULL AS VARCHAR) AS sequence2,
         CAST(NULL AS UTINYINT[]) AS qual2,
         i AS sequence_index
  FROM range(0, 3000000) t(i);

statement ok
CREATE TABLE big_result AS
  SELECT * FROM ena_upload_reads(relation := 'big_reads',
                                 target_url := 'file://{TEST_DIR}/bigmem/');

# One single-end file, non-empty.
query II
SELECT layout, bytes_written > 0 FROM big_result;
----
single	true

# Losslessness at scale: every read survived the encode→gzip→decode round-trip.
query I
SELECT count(*) FROM read_fastx('{TEST_DIR}/bigmem/bigsample.fastq.gz');
----
3000000
