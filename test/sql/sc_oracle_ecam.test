# name: test/sql/sc_oracle_ecam.test
# description: validate the SQL fit/predict path against sc's ECAM oracle fixture
# group: [sql]

require miint

require json

statement ok
PRAGMA enable_verification;

# The only test here that checks against an EXTERNAL reference rather than our
# own output. sc's oracle fixtures were generated by scikit-learn 1.4.2 through
# the qiime2 amplicon pipeline (see the `generator` block), so clearing their
# bands means the whole path -- DuckDB table, COO builder, Arrow FFI, sc-core --
# reproduces what the reference implementation does on the same 126 x 150 data.
#
# Read straight out of ext/sc rather than copied into test data, so the test
# cannot drift from the fixture it is validating against.
statement ok
CREATE TABLE fx AS SELECT * FROM read_json('ext/sc/oracle/fixtures/forest/agg_ecam.json');

# unnest over three parallel lists zips them positionally -- that IS the COO.
#
# Ids are zero-padded so that sorting them as text keeps the fixture's column
# order: unpadded, 'feat_10' would sort before 'feat_2'. Correctness does not
# depend on it, since fit and predict match features by name. But column order
# steers which features sc draws at each split, so keeping the fixture's order
# keeps this run as close to the reference as a different RNG allows.
statement ok
CREATE TABLE ecam AS
  SELECT printf('sample_%03d', unnest(data_coo.rows)) AS sample_id,
         printf('feat_%03d',   unnest(data_coo.cols)) AS feature_id,
         unnest(data_coo.vals) AS value
  FROM fx;

statement ok
CREATE TABLE ecam_meta AS
  SELECT printf('sample_%03d', generate_subscripts(values, 1) - 1) AS sample_id,
         unnest(values) AS value
  FROM fx;

statement ok
CREATE TABLE ecam_ref AS
  SELECT printf('feat_%03d', generate_subscripts(ref_importances, 1) - 1) AS feature_id,
         unnest(ref_importances) AS ref_importance
  FROM fx;

# The COO round-trips into relational form with nothing lost or duplicated.
query III
SELECT count(*), count(DISTINCT sample_id), count(DISTINCT feature_id) FROM ecam;
----
4648	126	150

query II
SELECT (SELECT count(*) FROM ecam_meta), (SELECT count(*) FROM ecam_ref);
----
126	150

# --- the oracle's own train/test split ---

statement ok
CREATE TABLE tr_ids AS SELECT printf('sample_%03d', unnest(train_idx)) AS sample_id FROM fx;

statement ok
CREATE TABLE te_ids AS SELECT printf('sample_%03d', unnest(test_idx)) AS sample_id FROM fx;

query II
SELECT (SELECT count(*) FROM tr_ids), (SELECT count(*) FROM te_ids);
----
94	32

statement ok
CREATE TABLE tr AS SELECT * FROM ecam SEMI JOIN tr_ids USING (sample_id);

statement ok
CREATE TABLE te AS SELECT * FROM ecam SEMI JOIN te_ids USING (sample_id);

statement ok
CREATE TABLE tr_meta AS SELECT * FROM ecam_meta SEMI JOIN tr_ids USING (sample_id);

statement ok
CREATE TABLE split_model AS
  SELECT * FROM fit_regressor('tr', 'tr_meta', n_estimators := 25, random_state := 20260707, name := 'm53');

# The model's width is the training data's, and the split kept every feature.
query II
SELECT n_samples, n_features FROM split_model;
----
94	150

# r2 and mse on the held-out samples must land inside the bands scikit-learn
# produced on the same split, scored and widened exactly as sc's own oracle test
# does (sc-core metrics::linear_regress, sc-oracle AggregateBand::contains): r2
# is the squared Pearson correlation of actual and predicted, not 1 - SSE/SST,
# and each band edge widens by margin_abs + margin_rel * |edge|. The bands come
# from the fixture, so this stays correct if the fixture is ever regenerated.
statement ok
CREATE TABLE split_scores AS
  SELECT corr(m.value, p.prediction) ^ 2 AS r2, avg((m.value - p.prediction) ^ 2) AS mse
  FROM predict('te', 'split_model') p JOIN ecam_meta m USING (sample_id);

query II
SELECT r2 BETWEEN band.min - (band.margin_abs + band.margin_rel * abs(band.min))
              AND band.max + (band.margin_abs + band.margin_rel * abs(band.max)),
       mse BETWEEN mse_band.min - (mse_band.margin_abs + mse_band.margin_rel * abs(mse_band.min))
               AND mse_band.max + (mse_band.margin_abs + mse_band.margin_rel * abs(mse_band.max))
FROM split_scores, fx;
----
true	true

# Every held-out sample is predicted, and all of them share the model's
# vocabulary because both splits came from one table.
query II
SELECT count(*), bool_and(known_feature_fraction = 1.0) FROM predict('te', 'split_model');
----
32	true

# --- feature importances against sklearn's ---

statement ok
CREATE TABLE full_model AS
  SELECT * FROM fit_regressor('ecam', 'ecam_meta', n_estimators := 25, random_state := 20260707, name := 'm54');

# sc's RNG is not sklearn's, so the forests differ and the importances cannot
# match exactly. The oracle compares them by Spearman correlation against a
# floor, and so does this, ranked as the oracle ranks: ties take their average
# position (scipy's rankdata default). Many importances here are exactly zero,
# and rank()'s lowest-position ties would give a different correlation.
query I
WITH ours AS (SELECT feature_id, importance FROM feature_importances('full_model')),
     j AS (SELECT o.importance AS mine, r.ref_importance AS ref
           FROM ours o JOIN ecam_ref r USING (feature_id)),
     ranked AS (SELECT rank() OVER (ORDER BY mine) + (count(*) OVER (PARTITION BY mine) - 1) / 2.0 AS rm,
                       rank() OVER (ORDER BY ref) + (count(*) OVER (PARTITION BY ref) - 1) / 2.0 AS rr
                FROM j)
SELECT corr(rm, rr) >= (SELECT rank_corr_floor - rank_corr_margin FROM fx) FROM ranked;
----
true

# Both sets are normalised over the same 150 features.
query II
SELECT abs(sum(importance) - 1.0) < 1e-9, count(*) FROM feature_importances('full_model');
----
true	150

# --- the column order the padding keeps ---

# Sorted as text, the ids come out in the fixture's column order. Asserted
# directly, so a change to the printf format shows up here.
query I
SELECT list(feature_id ORDER BY feature_id)[1:3] = ['feat_000','feat_001','feat_002']
FROM (SELECT DISTINCT feature_id FROM ecam);
----
true

# --- cross-validation against sc's nested-CV fixture ---
#
# The only external check on the cross-validation path. sc's ncv oracle scores
# out-of-fold predictions on the same ECAM data. It injects sklearn's own folds
# (fold_ids), which SQL cannot pass, so the folds here are sc's, drawn from
# random_state: a looser comparison than sc's own test. Out-of-fold predictions
# joined to the wrong samples would still fall far below the r2 band.
statement ok
CREATE TABLE ncv AS SELECT * FROM read_json('ext/sc/oracle/fixtures/ncv/agg_ecam.json');

# The same data as the forest fixture, and the protocol the call below follows.
query IIII
SELECT (SELECT data_coo FROM ncv) = (SELECT data_coo FROM fx), (SELECT values FROM ncv) = (SELECT values FROM fx),
       n_splits, n_estimators
FROM ncv;
----
true	true	5	25

statement ok
CREATE TABLE cv_scores AS
  SELECT corr(actual, prediction) ^ 2 AS r2, avg((actual - prediction) ^ 2) AS mse
  FROM cross_validate_regressor('ecam', 'ecam_meta', n_folds := 5, n_estimators := 25, random_state := 20260707);

query II
SELECT r2 BETWEEN band.min - (band.margin_abs + band.margin_rel * abs(band.min))
              AND band.max + (band.margin_abs + band.margin_rel * abs(band.max)),
       mse BETWEEN mse_band.min - (mse_band.margin_abs + mse_band.margin_rel * abs(mse_band.min))
               AND mse_band.max + (mse_band.margin_abs + mse_band.margin_rel * abs(mse_band.max))
FROM cv_scores, ncv;
----
true	true
