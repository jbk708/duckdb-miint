# vsearch (v2.30.5-miint fork): search, clustering, chimera detection, DUST
# masking and merge-pairs. Autotools-based; off on Windows.
#
# Under Emscripten no vsearch change is needed: wasm32 is none of the x86_64 /
# ppc64le / aarch64 targets vsearch knows, so its configure selects the generic
# target and vsearch.h routes the SSE code through its vendored SIMDe headers
# (third_party/simde, PROG_CPU "simde"), which lower to wasm SIMD128 under
# -msimd128 -- the flag minimap2 is already built with here.

# Build vsearch from source (v2.30.5-miint fork) using autotools. Produces
# libvsearch.a — a PIC static archive for embedding vsearch's search,
# clustering, chimera detection, DUST masking, and merge-pairs algorithms into
# the extension.
set(VSEARCH_SRC_DIR ${CMAKE_CURRENT_SOURCE_DIR}/ext/vsearch)
# Where autotools runs. Natively that is the submodule itself (in-source).
set(VSEARCH_BUILD_DIR ${VSEARCH_SRC_DIR})
set(VSEARCH_DIR_ARGS BUILD_IN_SOURCE 1)
# Extra leading configure step; empty natively so that command is unchanged.
set(VSEARCH_STAGE_COMMAND "")

# Cross-compilation (same pattern as htslib)
set(VSEARCH_ARCH_CFLAGS "${MIINT_OSX_ARCH_CFLAGS}")
if(EMSCRIPTEN)
  # -Wno-c++11-narrowing: vsearch brace-initializes Span<char>{ptr, len} with a
  # uint64_t len (buffer/header lengths), an error where size_t is 32-bit. The
  # value is the length of an in-memory buffer, which cannot exceed wasm32's
  # address space, so the narrowing cannot truncate.
  set(VSEARCH_ARCH_CFLAGS
      "-msimd128 -Wno-c++11-narrowing ${EMSCRIPTEN_THREAD_CFLAGS}")
  # Build from a private copy of the tracked sources. The native build
  # configures ext/vsearch in place and links ext/vsearch/src/libvsearch.a
  # directly, so an in-source wasm build in the same checkout would replace it
  # with wasm objects. (autotools' own out-of-tree build is refused once the
  # source tree has been configured in place.)
  set(VSEARCH_BUILD_DIR ${CMAKE_CURRENT_BINARY_DIR}/vsearch_src)
  set(VSEARCH_DIR_ARGS BINARY_DIR ${VSEARCH_BUILD_DIR})
  set(VSEARCH_STAGE_SH ${CMAKE_CURRENT_BINARY_DIR}/vsearch_stage.sh)
  file(
    WRITE ${VSEARCH_STAGE_SH}
    "#!/bin/sh
# Copy vsearch's tracked files (including the SIMDe submodule) into a private
# build tree. Generated by cmake/deps/vsearch.cmake; do not edit.
set -e
mkdir -p \"$2\"
cd \"$1\"
git ls-files -z --recurse-submodules | tar --null -T - -cf - | tar -xf - -C \"$2\"
")
  set(VSEARCH_STAGE_COMMAND sh ${VSEARCH_STAGE_SH} ${VSEARCH_SRC_DIR}
                            ${VSEARCH_BUILD_DIR} COMMAND)
  message(
    STATUS "vsearch cross-compiling for Emscripten/WASM (SIMDe -> SIMD128)")
endif()

ExternalProject_Add(
  vsearch_build
  SOURCE_DIR ${VSEARCH_SRC_DIR}
  # vsearch upstream gitignores `configure`, `Makefile.in`, etc. — they are
  # generated on demand by autogen.sh (autoreconf --force --install). A fresh CI
  # checkout has none of them, so we must regenerate here before invoking
  # configure.
  CONFIGURE_COMMAND ${VSEARCH_STAGE_COMMAND} ${CMAKE_COMMAND} -E chdir
                    ${VSEARCH_BUILD_DIR} sh ./autogen.sh
  # -O3: autoconf treats a user-supplied CXXFLAGS/CFLAGS as authoritative and
  # drops its default -O2, and vsearch's Makefile.am does not hardcode an
  # optimization level — so without an explicit -O here the whole library
  # (including the SIMD Needleman-Wunsch aligner) builds at -O0, ~4x slower.
  COMMAND
    ${CMAKE_COMMAND} -E env "CXXFLAGS=-O3 -fPIC ${VSEARCH_ARCH_CFLAGS}"
    "CFLAGS=-O3 -fPIC ${VSEARCH_ARCH_CFLAGS}" ${VSEARCH_BUILD_DIR}/configure
    ${MIINT_AUTOTOOLS_HOST}
  BUILD_COMMAND make -C src libvsearch.a
  INSTALL_COMMAND "" ${VSEARCH_DIR_ARGS}
  BUILD_BYPRODUCTS ${VSEARCH_BUILD_DIR}/src/libvsearch.a)

# Create imported library for vsearch
add_library(vsearch STATIC IMPORTED GLOBAL)
set_target_properties(vsearch PROPERTIES IMPORTED_LOCATION
                                         ${VSEARCH_BUILD_DIR}/src/libvsearch.a)
add_dependencies(vsearch vsearch_build)

miint_git_version(VSEARCH ext/vsearch)
list(APPEND MIINT_DEFINITIONS MIINT_HAS_VSEARCH)
list(APPEND MIINT_INCLUDE_DIRS ${VSEARCH_SRC_DIR}/src)
if(EMSCRIPTEN)
  # The wrappers include vsearch.h, which takes its SIMDe branch here.
  list(APPEND MIINT_INCLUDE_DIRS ${VSEARCH_SRC_DIR}/third_party/simde)
endif()
set(VSEARCH_SOURCES
    src/VsearchChimeraWrapper.cpp
    src/VsearchSearchWrapper.cpp
    src/VsearchClusterWrapper.cpp
    src/mask_dust_function.cpp
    src/merge_pairs_function.cpp
    src/search_sequences.cpp
    src/cluster_sequences.cpp
    src/uchime_common.cpp
    src/uchime_ref.cpp
    src/uchime_denovo.cpp)
list(APPEND MIINT_EXTENSION_SOURCES ${VSEARCH_SOURCES})
if(EMSCRIPTEN)
  # Same SIMD mode as libvsearch.a: SIMDe's vector types (reached through
  # vsearch.h) lower differently with and without -msimd128, so mixing modes
  # across the wrapper/library boundary would disagree on signatures.
  set_source_files_properties(${VSEARCH_SOURCES} PROPERTIES COMPILE_OPTIONS
                                                            -msimd128)
endif()
list(
  APPEND
  MIINT_TEST_SOURCES
  src/VsearchChimeraWrapper.cpp
  test/cpp/test_VsearchChimeraWrapper.cpp
  src/VsearchSearchWrapper.cpp
  test/cpp/test_VsearchSearchWrapper.cpp
  src/VsearchClusterWrapper.cpp
  test/cpp/test_VsearchClusterWrapper.cpp
  test/cpp/test_VsearchSerial.cpp)
list(APPEND MIINT_LINK_LIBRARIES vsearch)
list(APPEND MIINT_WASM_LIBS ${VSEARCH_BUILD_DIR}/src/libvsearch.a)
