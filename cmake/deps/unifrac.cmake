# unifrac-binaries + scikit-bio-binaries: in-memory static archives for UniFrac
# (PCoA / PERMANOVA / Faith PD). Native uses `make inmem_static` (libssu_inmem.a
# / libskbb_inmem.a — Eigen-backed, no HDF5/lz4/BLAS), emscripten uses `make
# wasm` (libssu_wasm.a / libskbb_wasm.a — same subset, compiled with em++).
# Disabled on Windows.
set(SKBB_SRC_DIR ${CMAKE_CURRENT_SOURCE_DIR}/ext/scikit-bio-binaries)
set(UNIFRAC_SRC_DIR ${CMAKE_CURRENT_SOURCE_DIR}/ext/unifrac-binaries)

if(EMSCRIPTEN)
  set(SKBB_LIB_NAME libskbb_wasm.a)
  set(UNIFRAC_LIB_NAME libssu_wasm.a)
  set(SKBB_MAKE_TARGET wasm)
  set(UNIFRAC_MAKE_TARGET wasm)
else()
  set(SKBB_LIB_NAME libskbb_inmem.a)
  set(UNIFRAC_LIB_NAME libssu_inmem.a)
  set(SKBB_MAKE_TARGET inmem_static)
  set(UNIFRAC_MAKE_TARGET inmem_static)
endif()

set(SKBB_LIB_PATH ${SKBB_SRC_DIR}/src/${SKBB_LIB_NAME})
set(UNIFRAC_LIB_PATH ${UNIFRAC_SRC_DIR}/src/${UNIFRAC_LIB_NAME})

# skbb's inmem and wasm builds both depend on Eigen 3.4.0 in
# .wasm-cache/eigen/include/. fetch_eigen.sh is idempotent — cache hit returns
# immediately. Requires network on first configure (mirrors the upstream WASM
# build's expectation).
#
# WASM PIC patch: both libskbb_wasm.a and libssu_wasm.a are linked into the
# duckdb-miint extension as a WASM side module (-sSIDE_MODULE=2), which requires
# every translation unit to be position-independent. Upstream's
# wasm/emscripten_build.mk does NOT include -fPIC in WASM_CXXFLAGS (the inmem
# path does, but the WASM path was authored standalone and never linked into a
# side module before). Patch -fPIC in idempotently before the WASM build. File
# an upstream PR to land this in skbb / unifrac-binaries' WASM build rules and
# drop these patches when both submodules ship the fix.
#
# Gated on EMSCRIPTEN to keep native builds from dirtying the submodule worktree
# (the patch is a no-op on native, but the touched-by-sed file still shows up in
# `git status` of the submodule). The patch script grep-guards the sed, then
# re-greps to fail loud if the sed didn't actually match — sed -i exits 0
# whether or not it substituted, so a submodule advance that renames the
# assignment would otherwise produce a cryptic R_WASM_MEMORY_ADDR_SLEB link
# error downstream instead of a clear "patch didn't take" message.
#
# Written to a file rather than passed inline because CMake splits `set(VAR
# "a;b;c")`-style strings on `;` when expanding them into a command list, and
# shell flow control here needs semicolons.
if(EMSCRIPTEN)
  set(WASM_PIC_PATCH_SH ${CMAKE_CURRENT_BINARY_DIR}/wasm_pic_patch.sh)
  file(
    WRITE ${WASM_PIC_PATCH_SH}
    "#!/bin/sh
# Idempotent -fPIC patch for libssu/libskbb's WASM emscripten_build.mk.
# Generated by cmake/deps/unifrac.cmake; do not edit.
set -e
if grep -q '^WASM_CXXFLAGS := -fPIC' \"$1\"; then
  exit 0
fi
sed -i 's|^WASM_CXXFLAGS := |WASM_CXXFLAGS := -fPIC |' \"$1\"
if ! grep -q '^WASM_CXXFLAGS := -fPIC' \"$1\"; then
  echo \"ERROR: WASM -fPIC patch did not take in $1 — submodule advanced past the patch's assumptions; update cmake/deps/unifrac.cmake or land the fix upstream\" >&2
  exit 1
fi
")
  set(SKBB_WASM_PATCH sh ${WASM_PIC_PATCH_SH}
                      ${SKBB_SRC_DIR}/src/wasm/emscripten_build.mk)
  set(UNIFRAC_WASM_PATCH sh ${WASM_PIC_PATCH_SH}
                         ${UNIFRAC_SRC_DIR}/src/wasm/emscripten_build.mk)
else()
  set(SKBB_WASM_PATCH ${CMAKE_COMMAND} -E true)
  set(UNIFRAC_WASM_PATCH ${CMAKE_COMMAND} -E true)
endif()

# ext/{scikit-bio-binaries,unifrac-binaries}/src/inmem_build.mk default
# INMEM_MPFLAG=-fopenmp. Apple Clang rejects bare -fopenmp outright
# ("unsupported option '-fopenmp'"); it requires -Xpreprocessor -fopenmp to
# enable the pragmas at preprocess time, then libomp gets linked separately.
# Also needs -I for libomp's headers since Apple's clang doesn't auto-search
# Homebrew paths. Mirrors GPL-boundary build.rs.
if(APPLE)
  set(MIINT_INMEM_MPFLAG_ARG
      "INMEM_MPFLAG=-Xpreprocessor -fopenmp -I${MIINT_LIBOMP_INCLUDE_DIR}")
else()
  set(MIINT_INMEM_MPFLAG_ARG "")
endif()

ExternalProject_Add(
  skbb_build
  SOURCE_DIR ${SKBB_SRC_DIR}
  CONFIGURE_COMMAND bash ${SKBB_SRC_DIR}/scripts/fetch_eigen.sh
  BUILD_COMMAND ${SKBB_WASM_PATCH}
  COMMAND make -C ${SKBB_SRC_DIR}/src ${SKBB_MAKE_TARGET}
          ${MIINT_INMEM_MPFLAG_ARG}
  INSTALL_COMMAND ""
  BUILD_IN_SOURCE 1
  BUILD_BYPRODUCTS ${SKBB_LIB_PATH})

# unifrac's inmem build expects SKBB_DIR pointing at the skbb source tree
# (defaults to ../../scikit-bio-binaries which is wrong for our layout). The
# wasm path uses the same variable.
ExternalProject_Add(
  unifrac_build
  SOURCE_DIR ${UNIFRAC_SRC_DIR}
  CONFIGURE_COMMAND ""
  BUILD_COMMAND ${UNIFRAC_WASM_PATCH}
  COMMAND make -C ${UNIFRAC_SRC_DIR}/src ${UNIFRAC_MAKE_TARGET}
          SKBB_DIR=${SKBB_SRC_DIR} ${MIINT_INMEM_MPFLAG_ARG}
  INSTALL_COMMAND ""
  BUILD_IN_SOURCE 1
  BUILD_BYPRODUCTS ${UNIFRAC_LIB_PATH}
  DEPENDS skbb_build)

add_library(libskbb STATIC IMPORTED GLOBAL)
set_target_properties(libskbb PROPERTIES IMPORTED_LOCATION ${SKBB_LIB_PATH})
add_dependencies(libskbb skbb_build)

add_library(libssu STATIC IMPORTED GLOBAL)
set_target_properties(libssu PROPERTIES IMPORTED_LOCATION ${UNIFRAC_LIB_PATH})
add_dependencies(libssu unifrac_build)

miint_git_version(UNIFRAC ext/unifrac-binaries)
miint_git_version(SKBB ext/scikit-bio-binaries)
list(APPEND MIINT_DEFINITIONS MIINT_HAS_UNIFRAC)
list(APPEND MIINT_INCLUDE_DIRS ${UNIFRAC_SRC_DIR}/src
     ${SKBB_SRC_DIR}/src/extern)
list(
  APPEND
  MIINT_EXTENSION_SOURCES
  src/unifrac_support_biom.cpp
  src/unifrac_bptree.cpp
  src/unifrac_metadata.cpp
  src/unifrac_distance.cpp
  src/unifrac_omp_scope.cpp
  src/unifrac_subsample_bridge.cpp
  src/unifrac_pcoa_function.cpp
  src/unifrac_permanova_function.cpp
  src/unifrac_faith_pd_function.cpp
  src/unifrac_distances_function.cpp
  src/rarefy_feature_table_function.cpp
  src/progressive_pcoa_core.cpp)
list(
  APPEND
  MIINT_TEST_SOURCES
  src/unifrac_support_biom.cpp
  src/unifrac_bptree.cpp
  src/unifrac_metadata.cpp
  src/unifrac_distance.cpp
  src/unifrac_omp_scope.cpp
  src/unifrac_subsample_bridge.cpp
  test/cpp/test_UnifracSupportBiom.cpp
  test/cpp/test_UnifracBptree.cpp
  test/cpp/test_UnifracMetadata.cpp
  test/cpp/test_UnifracDistance.cpp
  test/cpp/test_UnifracCondensed.cpp
  test/cpp/test_UnifracDenseDistance.cpp
  test/cpp/test_UnifracSubsampleBridge.cpp
  src/progressive_pcoa_core.cpp
  test/cpp/test_ProgressivePcoa.cpp
  test/cpp/test_SkbbConcurrency.cpp)
# libssu (unifrac-binaries) references libskbb (skbio) symbols, so libssu must
# precede libskbb in link order for static-archive resolution. Native
# libssu_inmem.a is compiled with -fopenmp (see ext/unifrac-binaries/
# src/inmem_build.mk INMEM_MPFLAG); libssu_wasm.a is OpenMP-free per
# ext/unifrac-binaries/src/wasm/emscripten_build.mk header. Only link libgomp on
# non-EMSCRIPTEN.
list(APPEND MIINT_LINK_LIBRARIES libssu libskbb)
if(NOT EMSCRIPTEN)
  list(APPEND MIINT_LINK_LIBRARIES miint_openmp)
endif()
list(APPEND MIINT_WASM_LIBS ${UNIFRAC_LIB_PATH} ${SKBB_LIB_PATH})
