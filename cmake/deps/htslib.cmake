# HTSlib 1.22.1 (release tarball in ext/, not a submodule): SAM/BAM/CRAM
# parsing. Always built. Configure with zstd support if available (htslib
# autodetects via pkg-config).
if(HAVE_LIBZSTD OR MIINT_ENABLE_LIBDEFLATE)
  # Set PKG_CONFIG_PATH so htslib configure can find zstd / libdeflate
  set(HTSLIB_PKG_CONFIG_PATH
      "PKG_CONFIG_PATH=${CMAKE_CURRENT_BINARY_DIR}/vcpkg_installed/${VCPKG_TARGET_TRIPLET}/lib/pkgconfig"
  )
else()
  set(HTSLIB_PKG_CONFIG_PATH "")
endif()

# Emscripten: tell autotools we are cross-compiling. -fPIC IS required: the
# extension is linked as a WASM side module (-sSIDE_MODULE=2) which needs
# position-independent code for all linked objects.
if(EMSCRIPTEN)
  message(STATUS "HTSlib cross-compiling for Emscripten/WASM")
elseif(MIINT_OSX_ARCH_CFLAGS)
  message(STATUS "HTSlib cross-compiling (${MIINT_OSX_ARCH_CFLAGS})")
endif()

# -O2: passing CFLAGS to htslib's configure overrides its Makefile default (-g
# -Wall -O2), so an explicit -O is required or htslib builds at -O0. -O2 matches
# htslib/samtools upstream's shipping optimization level.
set(HTSLIB_CFLAGS
    "CFLAGS=-O2 -fPIC ${MIINT_OSX_ARCH_CFLAGS} ${EMSCRIPTEN_THREAD_CFLAGS} -I${ZLIB_INCLUDE_DIRS}"
)
if(ZLIB_LIBRARY_DIR)
  set(HTSLIB_LDFLAGS "LDFLAGS=${MIINT_OSX_ARCH_CFLAGS} -L${ZLIB_LIBRARY_DIR}")
else()
  set(HTSLIB_LDFLAGS "LDFLAGS=${MIINT_OSX_ARCH_CFLAGS}")
endif()

# Set LIBS to pass explicit library path to configure (needed for OSX with
# vcpkg)
if(ZLIB_LIBRARY_FILE)
  set(HTSLIB_LIBS "LIBS=${ZLIB_LIBRARY_FILE}")
else()
  set(HTSLIB_LIBS "")
endif()

# libdeflate (Linux opt-in): point htslib's configure at the vcpkg-installed
# headers and lib. htslib probes libdeflate via AC_CHECK_HEADER/AC_CHECK_LIB
# (not pkg-config), so feed -I/-L directly rather than trusting libdeflate.pc.
# --with-libdeflate makes it mandatory: configure errors loudly if not found
# (Rule 10) instead of silently using zlib.
if(MIINT_ENABLE_LIBDEFLATE)
  set(HTSLIB_VCPKG_ROOT
      ${CMAKE_CURRENT_BINARY_DIR}/vcpkg_installed/${VCPKG_TARGET_TRIPLET})
  set(HTSLIB_CFLAGS "${HTSLIB_CFLAGS} -I${HTSLIB_VCPKG_ROOT}/include")
  set(HTSLIB_LDFLAGS "${HTSLIB_LDFLAGS} -L${HTSLIB_VCPKG_ROOT}/lib")
  set(HTSLIB_LIBDEFLATE_FLAG --with-libdeflate)
  message(STATUS "HTSlib will build WITH libdeflate from ${HTSLIB_VCPKG_ROOT}")
else()
  set(HTSLIB_LIBDEFLATE_FLAG --without-libdeflate)
endif()

if(WIN32)
  # Windows/MinGW: skip autotools configure (requires full MSYS2 shell which is
  # not available in DuckDB's rtools42 CI environment). Instead, generate
  # config.h and config.mk manually to match our --disable-libcurl --disable-bz2
  # etc. flags. config.mk sets NONCONFIGURE_OBJS= to prevent hfile_libcurl.o
  # from being built. config.h is generated with only the features we need (zlib
  # only). See:
  # https://github.com/samtools/htslib/blob/develop/.github/workflows/windows-build.yml
  set(HTSLIB_SRC ${CMAKE_CURRENT_SOURCE_DIR}/ext/htslib-1.22.1)
  set(HTSLIB_CONFIG_H "${HTSLIB_SRC}/config.h")
  set(HTSLIB_CONFIG_MK "${HTSLIB_SRC}/config.mk")
  # Generate config.h: minimal — zlib only, no curl/bz2/lzma/libdeflate
  file(WRITE ${HTSLIB_CONFIG_H}
       "/* config.h generated by CMake for Windows/MinGW (no autotools) */\n"
       "#define HAVE_FSEEKO 1\n")
  # Generate config.mk: blank NONCONFIGURE_OBJS to prevent hfile_libcurl.o, set
  # LIBS to just -lz, and disable features we don't need.
  file(
    WRITE ${HTSLIB_CONFIG_MK}
    "# config.mk generated by CMake for Windows/MinGW (no autotools)\n"
    "NONCONFIGURE_OBJS =\n"
    "CFLAGS = -g -Wall -O2 -fvisibility=hidden -I${ZLIB_INCLUDE_DIRS}\n"
    "LDFLAGS = -fvisibility=hidden\n"
    "LIBS = -lz\n"
    "prefix = ${CMAKE_CURRENT_BINARY_DIR}/htslib\n")
  ExternalProject_Add(
    htslib_build
    SOURCE_DIR ${HTSLIB_SRC}
    CONFIGURE_COMMAND ""
    BUILD_COMMAND make -C ${HTSLIB_SRC} clean
    COMMAND make -C ${HTSLIB_SRC} libhts.a
    INSTALL_COMMAND ${CMAKE_COMMAND} -E make_directory
                    ${CMAKE_CURRENT_BINARY_DIR}/htslib/lib
    COMMAND ${CMAKE_COMMAND} -E copy ${HTSLIB_SRC}/libhts.a
            ${CMAKE_CURRENT_BINARY_DIR}/htslib/lib/libhts.a
    COMMAND ${CMAKE_COMMAND} -E make_directory
            ${CMAKE_CURRENT_BINARY_DIR}/htslib/include/htslib
    COMMAND ${CMAKE_COMMAND} -E copy_directory ${HTSLIB_SRC}/htslib
            ${CMAKE_CURRENT_BINARY_DIR}/htslib/include/htslib
    BUILD_IN_SOURCE 1
    BUILD_BYPRODUCTS ${CMAKE_CURRENT_BINARY_DIR}/htslib/lib/libhts.a)
else()
  if(EMSCRIPTEN)
    # Emscripten/WASM doesn't support shared libraries, so htslib's default
    # 'make' (which builds both static and shared) and 'make install' (which
    # requires the shared lib) both fail. Build only the static library and
    # manually copy the artifacts.
    set(HTSLIB_BUILD_COMMAND make lib-static)
    # libhts.a is in <BINARY_DIR> (out-of-source build), but headers are
    # read-only source files so we copy them from the source tree directly.
    set(HTSLIB_INSTALL_COMMAND
        ${CMAKE_COMMAND} -E make_directory
        ${CMAKE_CURRENT_BINARY_DIR}/htslib/lib COMMAND ${CMAKE_COMMAND} -E copy
        <BINARY_DIR>/libhts.a ${CMAKE_CURRENT_BINARY_DIR}/htslib/lib/libhts.a
        COMMAND ${CMAKE_COMMAND} -E make_directory
        ${CMAKE_CURRENT_BINARY_DIR}/htslib/include/htslib COMMAND
        ${CMAKE_COMMAND} -E copy_directory
        ${CMAKE_CURRENT_SOURCE_DIR}/ext/htslib-1.22.1/htslib
        ${CMAKE_CURRENT_BINARY_DIR}/htslib/include/htslib)
  else()
    set(HTSLIB_BUILD_COMMAND make)
    set(HTSLIB_INSTALL_COMMAND make install)
  endif()
  ExternalProject_Add(
    htslib_build
    SOURCE_DIR ${CMAKE_CURRENT_SOURCE_DIR}/ext/htslib-1.22.1
    CONFIGURE_COMMAND
      env ${HTSLIB_CFLAGS} ${HTSLIB_LDFLAGS} ${HTSLIB_LIBS}
      ${HTSLIB_PKG_CONFIG_PATH}
      ${CMAKE_CURRENT_SOURCE_DIR}/ext/htslib-1.22.1/configure
      ${MIINT_AUTOTOOLS_HOST} --prefix=${CMAKE_CURRENT_BINARY_DIR}/htslib
      --disable-libcurl --disable-bz2 --disable-lzma ${HTSLIB_LIBDEFLATE_FLAG}
    BUILD_COMMAND ${HTSLIB_BUILD_COMMAND}
    INSTALL_COMMAND ${HTSLIB_INSTALL_COMMAND}
    BUILD_IN_SOURCE 0
    BUILD_BYPRODUCTS ${CMAKE_CURRENT_BINARY_DIR}/htslib/lib/libhts.a)
endif()

add_library(hts STATIC IMPORTED GLOBAL)
set_target_properties(
  hts PROPERTIES IMPORTED_LOCATION
                 ${CMAKE_CURRENT_BINARY_DIR}/htslib/lib/libhts.a)
file(MAKE_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/htslib/include)
add_dependencies(hts htslib_build)

list(APPEND MIINT_LINK_LIBRARIES hts)
list(APPEND MIINT_WASM_LIBS ${CMAKE_CURRENT_BINARY_DIR}/htslib/lib/libhts.a)
